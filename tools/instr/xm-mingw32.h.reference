/* w-diab: 2.7.2 configure has no generic i386 xm_file default (unlike 2.8.1,
   which prepends xm-i386.h automatically) -- pull it in explicitly so
   HOST_BITS_PER_{CHAR,INT,LONG} etc. are defined. */
#include "i386/xm-i386.h"

/* w-diab: mingw-w64 UCRT has no BSD string.h compat (index/rindex/bcmp/bcopy/
   bzero) that 2.7.2's C/C++ sources still call directly (c-common.c, tree.c,
   cp/lex.c).  A few TUs also carry a K&R `extern char *index ();` forward
   decl, which a FUNCTION-LIKE macro (index(s,c)) breaks ("requires 2
   arguments, but only 1 given") -- use `#define NAME NAME2` (object-like)
   renaming instead, which survives being "called" through a differently-
   prototyped extern decl exactly like the real libc symbol would.
   Host-only, no target-codegen effect. */
#include <string.h>
#define bcmp   memcmp
#define bcopy(s,d,n) memmove((d),(s),(n))
#define bzero(s,n)   memset((s),0,(n))
#define index  strchr
#define rindex strrchr

#define NO_STAB_H

#ifndef USG
#define USG 1
#endif

#ifndef ONLY_INT_FIELD
#define ONLY_INT_FIELDS 1
#endif

#ifndef USE_PROTOTYPES
#define USE_PROTOTYPES 1
#endif

#define NO_SYS_SIGLIST 1
#define environ _environ

/* Even though we support "/", allow "\" since everybody tests both.  */
#define DIR_SEPARATOR '\\'
#define EXECUTABLE_SUFFIX ".exe"

#undef PATH_SEPARATOR
#define PATH_SEPARATOR ';'
